generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        Int        @id @default(autoincrement())
  name      String

  users     User[]
  contracts Contract[]

  createdAt DateTime   @default(now())
}

model User {
  id         Int      @id @default(autoincrement())
  tenantId   Int

  name       String
  email      String   @unique

  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  contracts  Contract[]
  approvals  Approval[]

  createdAt  DateTime @default(now())
}

model Contract {
  id          Int       @id @default(autoincrement())
  tenantId    Int
  createdById Int

  name        String
  status      String

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  createdBy    User        @relation(fields: [createdById], references: [id])

  approvals    Approval[]
  comments     Comment[]

  createdAt    DateTime    @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
}

model Approval {
  id           Int       @id @default(autoincrement())

  contractId   Int
  approverId   Int

  status       String

  contract      Contract  @relation(fields: [contractId], references: [id])
  approver      User      @relation(fields: [approverId], references: [id])

  createdAt     DateTime  @default(now())
}

model Comment {
  id           Int       @id @default(autoincrement())

  contractId   Int
  message      String

  contract     Contract  @relation(fields: [contractId], references: [id])

  createdAt    DateTime  @default(now())
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  entityId   Int
  entityType String
  action     String
  performedBy Int
  createdAt  DateTime @default(now())
}